<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/rsounds_mark">

    <target android:name="logoGroup">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:duration="680"
                    android:propertyName="scaleX"
                    android:valueFrom="0.84"
                    android:valueTo="1"
                    android:valueType="floatType"
                    android:interpolator="@android:anim/overshoot_interpolator" />
                <objectAnimator
                    android:duration="680"
                    android:propertyName="scaleY"
                    android:valueFrom="0.84"
                    android:valueTo="1"
                    android:valueType="floatType"
                    android:interpolator="@android:anim/overshoot_interpolator" />
                <objectAnimator
                    android:duration="600"
                    android:propertyName="translateY"
                    android:valueFrom="22"
                    android:valueTo="0"
                    android:valueType="floatType"
                    android:interpolator="@android:anim/decelerate_interpolator" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="playGroup">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:startOffset="100"
                    android:duration="520"
                    android:propertyName="scaleX"
                    android:valueFrom="0.65"
                    android:valueTo="1"
                    android:valueType="floatType"
                    android:interpolator="@android:anim/overshoot_interpolator" />
                <objectAnimator
                    android:startOffset="100"
                    android:duration="520"
                    android:propertyName="scaleY"
                    android:valueFrom="0.65"
                    android:valueTo="1"
                    android:valueType="floatType"
                    android:interpolator="@android:anim/overshoot_interpolator" />
                <objectAnimator
                    android:startOffset="100"
                    android:duration="360"
                    android:propertyName="alpha"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:valueType="floatType"
                    android:interpolator="@android:interpolator/linear_out_slow_in" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
